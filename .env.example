# Copy this file to .env and fill in real values. Never commit .env.
# Every variable here is read via django-environ in settings/base.py.

# Django
# DJANGO_ENV selects the settings module: dev (default) or prod
DJANGO_ENV=dev
# Required in prod — generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Comma-separated list of allowed hosts, e.g. localhost,127.0.0.1,api.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# True/False. prod.py refuses to enable DEBUG via this var only if you set it True.
DJANGO_DEBUG=True
# Expose Swagger/OpenAPI docs. dev defaults to True, prod to False.
DJANGO_ENABLE_API_SCHEMA=True
# HMAC key that digests project API keys before storage. Leave blank in dev
# (falls back to DJANGO_SECRET_KEY); set a distinct value in prod.
API_KEY_HASH_SECRET=

# Auth
# AUTH_DEV_OTP, when set, is accepted as a valid verification code for any user.
# Set to "000000" in dev/demo; leave blank in real deployments so only real
# emailed codes verify.
AUTH_DEV_OTP=000000
# Empty => POST /auth/google/ runs in stub mode (no token verification).
# For real Google sign-in, set your Google OAuth client ID here.
GOOGLE_CLIENT_ID=
# Refresh-token cookie hardening (prod forces Secure via prod.py).
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax
# Frontend origin(s) allowed to read the auth cookie.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
# Phase 5D (prod only — both are REQUIRED when DJANGO_ENV=prod, no fallback):
# origins trusted for cookie-based CSRF flows (Slack OAuth callback, etc.),
# e.g. https://app.example.com,https://api.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Force HTTPS redirect (disable only behind a proxy that already enforces it
# and strips the header — see DJANGO_BEHIND_PROXY).
DJANGO_SECURE_SSL_REDIRECT=True
# HSTS max-age in seconds (default 1 year) + subdomain coverage.
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=False
# Set True when TLS terminates at a load balancer that sets
# X-Forwarded-Proto: https (lets redirect/HSTS/cookies see the real scheme).
DJANGO_BEHIND_PROXY=False
# OTP expiry/attempt limits.
AUTH_OTP_TTL_MINUTES=10
AUTH_OTP_MAX_ATTEMPTS=5
# Single-use registration token lifetime (OTP-first signup).
AUTH_REGISTRATION_TOKEN_TTL_MINUTES=15
# Hard per-email ceiling for signup codes (3 in 15 min), on top of the per-IP rate.
AUTH_REGISTER_EMAIL_CAP=3
AUTH_REGISTER_EMAIL_CAP_MINUTES=15

# Per-endpoint rate limits (per client IP). Format "N/min", "N/hour", ...
# Tune per deployment; dev defaults are generous (see settings/base.py).
AUTH_THROTTLE_LOGIN=30/min
AUTH_THROTTLE_REGISTER_REQUEST=10/min
AUTH_THROTTLE_REGISTER_VERIFY=30/min
AUTH_THROTTLE_REGISTER_COMPLETE=20/min
AUTH_THROTTLE_FORGOT=10/min
AUTH_THROTTLE_RESET=20/min
AUTH_THROTTLE_GOOGLE=20/min
AUTH_THROTTLE_REFRESH=30/min

# Event ingestion
# Cap on message+stacktrace bytes accepted by POST /api/v1/events/ (413 over).
EVENT_MAX_PAYLOAD_BYTES=100000
# Throttles on ingestion: per-IP cap and per-API-key cap.
EVENT_THROTTLE_IP=5000/min
EVENT_THROTTLE_KEY=30/s

# Brute-force lockout (django-axes) on POST /auth/login/. Failures are counted
# per (IP address, account) pair; after FAILURE_LIMIT the pair is locked for
# COOLOFF_TIME_HOURS. Set DJANGO_AXES_ENABLED=False to disable.
DJANGO_AXES_ENABLED=True
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_TIME_HOURS=0.25

# Redis for the Django cache (throttles). If set (prod), throttling uses Redis;
# otherwise falls back to per-process memory.
DJANGO_REDIS_URL=

# Dashboard aggregate cache safety-net TTL (Phase 5C). Per-project version
# bumps invalidate immediately; this only bounds staleness from rare writes
# that emit no signal (bulk ops, manual deletes).
DASHBOARD_CACHE_TTL_SECONDS=60
# Platform admin (staff-only /api/v1/admin/* monitoring). Per-user throttle
# plus the TTL on the cached overview aggregate (lists stay uncached).
ADMIN_THROTTLE=120/min
PLATFORM_ADMIN_CACHE_SECONDS=60
# Truncation cap for the error text sent to the model.
AI_PROMPT_MAX_CHARS=20000
# Backoff helper (base seconds, doubling per attempt). No automatic retries
# run without a worker — kept for the retry_countdown utility.
AI_RETRY_BASE_SECONDS=60

# PostgreSQL (only read by settings.prod — dev uses SQLite)
POSTGRES_DB=trazeiq
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Pusher realtime (Phase 3A) — empty creds = publishing is a no-op. The
# secret is never exposed to the frontend; /api/v1/pusher/auth/ signs channels.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=mt1
PUSHER_USE_TLS=True
PUSHER_PUBLISH_TIMEOUT_SECONDS=2.0

# Email (SMTP). Prod falls back to the console backend until these are set —
# without them, invite emails and alert emails only appear in server logs.
# Gmail example: HOST=smtp.gmail.com, PORT=587, TLS=True + an app password.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=TrazeIQ <no-reply@yourdomain.com>

# Slack alerts (Phase 4D) — empty id/secret = connect endpoint returns
# SLACK_NOT_CONFIGURED. Tokens received via OAuth are Fernet-encrypted at
# rest (key derived from DJANGO_SECRET_KEY — rotate carefully, see DEPLOY.md).
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_OAUTH_URL=https://slack.com/api/oauth.v2.access
SLACK_CHAT_POST_URL=https://slack.com/api/chat.postMessage
SLACK_API_TIMEOUT_SECONDS=5.0

# Alert dispatch + invites
# Public base URL of the frontend, used to build incident links in emails,
# Slack messages and webhooks. Must be the real https:// URL in prod.
APP_BASE_URL=http://localhost:3000
# Outbound dispatch (webhook POSTs, Slack calls) must never hang a worker.
DISPATCH_TIMEOUT_SECONDS=5.0
# How long an org invite link stays valid.
INVITE_TTL_MINUTES=10080



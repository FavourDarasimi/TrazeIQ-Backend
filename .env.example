# Copy this file to .env and fill in real values. Never commit .env.
# Every variable here is read via django-environ in settings/base.py.

# Django
# DJANGO_ENV selects the settings module: dev (default) or prod
DJANGO_ENV=dev
# Required in prod — generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Comma-separated list of allowed hosts, e.g. localhost,127.0.0.1,api.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# True/False. prod.py refuses to enable DEBUG via this var only if you set it True.
DJANGO_DEBUG=True
# Expose Swagger/OpenAPI docs. dev defaults to True, prod to False.
DJANGO_ENABLE_API_SCHEMA=True
# HMAC key that digests project API keys before storage. Leave blank in dev
# (falls back to DJANGO_SECRET_KEY); set a distinct value in prod.
API_KEY_HASH_SECRET=

# Auth
# AUTH_DEV_OTP, when set, is accepted as a valid verification code for any user.
# Set to "000000" in dev/demo; leave blank in real deployments so only real
# emailed codes verify.
AUTH_DEV_OTP=000000
# Empty => POST /auth/google/ runs in stub mode (no token verification).
# For real Google sign-in, set your Google OAuth client ID here.
GOOGLE_CLIENT_ID=
# Refresh-token cookie hardening (prod forces Secure via prod.py).
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax
# Frontend origin(s) allowed to read the auth cookie.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
# OTP expiry/attempt limits.
AUTH_OTP_TTL_MINUTES=10
AUTH_OTP_MAX_ATTEMPTS=5
# Single-use registration token lifetime (OTP-first signup).
AUTH_REGISTRATION_TOKEN_TTL_MINUTES=15
# Hard per-email ceiling for signup codes (3 in 15 min), on top of the per-IP rate.
AUTH_REGISTER_EMAIL_CAP=3
AUTH_REGISTER_EMAIL_CAP_MINUTES=15

# Per-endpoint rate limits (per client IP). Format "N/min", "N/hour", ...
# Tune per deployment; dev defaults are generous (see settings/base.py).
AUTH_THROTTLE_LOGIN=30/min
AUTH_THROTTLE_REGISTER_REQUEST=10/min
AUTH_THROTTLE_REGISTER_VERIFY=30/min
AUTH_THROTTLE_REGISTER_COMPLETE=20/min
AUTH_THROTTLE_FORGOT=10/min
AUTH_THROTTLE_RESET=20/min
AUTH_THROTTLE_GOOGLE=20/min
AUTH_THROTTLE_REFRESH=30/min

# Event ingestion
# Cap on message+stacktrace bytes accepted by POST /api/v1/events/ (413 over).
EVENT_MAX_PAYLOAD_BYTES=100000
# Throttles on ingestion: per-IP cap and per-API-key cap.
EVENT_THROTTLE_IP=5000/min
EVENT_THROTTLE_KEY=30/s

# Brute-force lockout (django-axes) on POST /auth/login/. Failures are counted
# per (IP address, account) pair; after FAILURE_LIMIT the pair is locked for
# COOLOFF_TIME_HOURS. Set DJANGO_AXES_ENABLED=False to disable.
DJANGO_AXES_ENABLED=True
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_TIME_HOURS=0.25

# Redis for the Django cache (throttles). If set (prod), throttling uses Redis;
# otherwise falls back to per-process memory.
DJANGO_REDIS_URL=

# PostgreSQL (only read by settings.prod — dev uses SQLite)
POSTGRES_DB=trazeiq
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
